generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  wallets   Wallet[]
}

model Nonce {
  id        Int      @id @default(autoincrement())
  value     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  // nonce is created for specific wallet
  walletId  Int
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  signatures Signature[]
}

model Wallet {
  id        Int      @id @default(autoincrement())
  address   String   @unique
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nonces    Nonce[]
  signatures Signature[]
}

model Signature {
  id        Int      @id @default(autoincrement())
  message   String
  signature String
  createdAt DateTime @default(now())
  walletId  Int
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  nonceId   Int?
  nonce     Nonce?   @relation(fields: [nonceId], references: [id], onDelete: SetNull)
}
